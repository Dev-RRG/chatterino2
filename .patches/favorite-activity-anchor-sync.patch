 void ChannelView::setLayoutWidthOverride(std::optional<int> width)
 {
     this->layoutWidthOverride_ = width;
     this->queueLayout(true);
 }
+
+std::optional<ChannelView::ScrollAnchor> ChannelView::getScrollAnchor()
+{
+    auto &messages = this->getMessagesSnapshot();
+    if (messages.empty())
+    {
+        return std::nullopt;
+    }
+
+    const qreal relative = this->scrollBar_->getRelativeCurrentValue();
+    const auto index = static_cast<size_t>(std::floor(relative));
+    if (index >= messages.size())
+    {
+        return std::nullopt;
+    }
+
+    return ScrollAnchor{messages[index]->getMessagePtr(),
+                        relative - std::floor(relative)};
+}
+
+bool ChannelView::scrollToAnchor(const ScrollAnchor &anchor)
+{
+    auto &messages = this->getMessagesSnapshot();
+    for (size_t index = 0; index < messages.size(); ++index)
+    {
+        if (messages[index]->getMessagePtr() == anchor.message)
+        {
+            this->scrollBar_->setDesiredValue(
+                this->scrollBar_->getMinimum() + static_cast<qreal>(index) +
+                std::clamp(anchor.fraction, qreal(0.0), qreal(0.999999)));
+            return true;
+        }
+    }
+    return false;
+}
 
 void ChannelView::setEnableScrollingToBottom(bool value)
 {
